# OpenSiteBackup self-contained config
# Copy to: config/env.sh

export OSB_HOME="$HOME/opensitebackup"

# Derived default paths (self-contained)
export OSB_CONFIG="${OSB_HOME}/config/env.sh"
export OSB_BACKUPS="${OSB_HOME}/data/backups"
export OSB_LOGS="${OSB_HOME}/data/logs"
export OSB_TMP="${OSB_HOME}/data/tmp"
export OSB_STATE="${OSB_HOME}/data/state"

# Source host (example: WordPress over SSH)
export LIVE_SSH_HOST="203.0.113.10"
export LIVE_SSH_USER="wpuser"
export LIVE_SITE_PATH="/home/wpuser/public_html"
export LIVE_SSH_KEY="$HOME/.ssh/id_ed25519"

# Optional: restore target outside OSB_HOME
export LOCAL_RESTORE_PATH="/home/operator/sites/example.com"
export LOCAL_URL="http://localhost:8080"

# Upload backend selection
# local | rclone | gog
export OSB_BACKEND="local"

# Optional backend-specific variables
# export DRIVE_ACCOUNT="you@gmail.com"
# export DRIVE_FILES_FOLDER_ID="..."
# export DRIVE_DB_FOLDER_ID="..."

# Optional direct-file restore from Drive (used by scripts/05_restore_from_drive.sh)
# export DRIVE_DB_FILE_ID="<google-drive-file-id-for-db.sql>"
# export DRIVE_FILES_FILE_ID="<google-drive-file-id-for-files.tar.gz>"

# Local DB values used when rewriting wp-config.php during restore-from-drive
# export LOCAL_DB_NAME="wp_local"
# export LOCAL_DB_USER="wp_user"
# export LOCAL_DB_PASSWORD="change-me"
# export LOCAL_DB_HOST="localhost"

# rclone backend (used when OSB_BACKEND=rclone)
# export RCLONE_REMOTE="myremote:Backups/WordPress/example.com"
# export RCLONE_FLAGS="--progress"
